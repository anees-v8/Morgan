# Google AI API
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_PROJECT_ID=webreel-prod
# Free-tier key from https://aistudio.google.com/apikey (put the real one in webreel/.env, never commit it)
# Models are tried in order; retired / no-free-quota models are skipped automatically.
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite
# To spend Google Cloud credits instead of the free tier: GOOGLE_GENAI_USE_VERTEXAI=1 + GOOGLE_CLOUD_PROJECT + GOOGLE_CLOUD_LOCATION
WEBREEL_NARRATION_LANGUAGE=English
WEBREEL_SCENES=4

# Database & Auth (Supabase Free)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_key

# Video Storage (Cloudflare R2 Free - Zero Egress)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret
R2_BUCKET_NAME=webreel-videos
R2_PUBLIC_URL=https://videos.webreel.in

# Engine Parameters
VIDEO_RESOLUTION_W=1920
VIDEO_RESOLUTION_H=1080
VIDEO_FPS=30
VIDEO_DURATION_TARGET=90
MAX_PAGES_TO_VISIT=5

# Voiceover Settings
TTS_DEFAULT_VOICE=en-US-ChristopherNeural
TTS_SPEED=1.08

# Server
APP_ENV=production
PORT=8000
